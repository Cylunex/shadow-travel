# Path to an external Java-properties file containing `key` and `jscode`.
# Never copy the credential values into this repository.
AMAP_PROPERTIES_FILE=REPLACE_WITH_AMAP_PROPERTIES_FILE

# Browser-restricted public key, NOT the server key. Enable Maps JavaScript API only.
# Inject from deployment environment; do not commit actual values.
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAP_ID=
