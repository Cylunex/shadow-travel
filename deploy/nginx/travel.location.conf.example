# Include these locations in the canonical HTTPS server block.
location = /travel {
    return 308 /travel/;
}

location = /travel/healthz {
    proxy_pass http://127.0.0.1:REPLACE_WITH_LOOPBACK_PORT/healthz;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-ID $request_id;
}

# Keep readiness internal unless the platform explicitly exposes it.
location = /travel/readyz {
    allow 127.0.0.1;
    deny all;
    proxy_pass http://127.0.0.1:REPLACE_WITH_LOOPBACK_PORT/readyz;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-ID $request_id;
}

location ~ ^/travel/(auth|api)(?:/|$) {
    rewrite ^/travel/(.*)$ /$1 break;
    proxy_pass http://127.0.0.1:REPLACE_WITH_LOOPBACK_PORT;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Request-ID $request_id;
}

location /travel/ {
    root /opt/shadow-travel/current/public;
    try_files $uri $uri/ /travel/index.html;
}
