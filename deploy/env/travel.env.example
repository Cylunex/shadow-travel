TRAVEL_ENVIRONMENT=production
TRAVEL_APP_ID=shadow-travel
TRAVEL_ROOT_PATH=/travel
TRAVEL_PUBLIC_ORIGIN=https://example.com
TRAVEL_DATABASE_URL=postgresql+psycopg://REPLACE_WITH_DATABASE_USER:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/REPLACE_WITH_DATABASE_NAME
TRAVEL_COOKIE_SECURE=true

TRAVEL_OIDC_ISSUER=https://auth.example.com
TRAVEL_OIDC_CLIENT_ID=shadow-travel
TRAVEL_OIDC_CLIENT_SECRET_FILE=/etc/shadow-travel/secrets/oidc-client-secret
TRAVEL_OIDC_REQUIRED_GROUP=travel-users

TRAVEL_AMAP_SERVER_KEY_FILE=/etc/shadow-travel/secrets/amap-web-service-key
TRAVEL_GOOGLE_MAPS_SERVER_KEY_FILE=REPLACE_WITH_GOOGLE_MAPS_SERVER_KEY_FILE

TRAVEL_MEDIA_BASE_URL=REPLACE_WITH_MEDIA_BASE_URL
TRAVEL_MEDIA_SERVICE_TOKEN_FILE=REPLACE_WITH_MEDIA_SERVICE_TOKEN_FILE

TRAVEL_LLM_REGISTRY_PATH=REPLACE_WITH_LLM_REGISTRY_PATH
TRAVEL_LLM_SECRETS_DIR=REPLACE_WITH_LLM_SECRETS_DIR
TRAVEL_LLM_USAGE_OUTBOX=/var/lib/shadow-travel/llm-usage.jsonl

TRAVEL_AGENT_REGISTRY_PATH=REPLACE_WITH_AGENT_REGISTRY_PATH
TRAVEL_AGENT_SECRETS_DIR=REPLACE_WITH_AGENT_SECRETS_DIR
TRAVEL_SYNC_TOKEN_HASH_FILE=REPLACE_WITH_SYNC_TOKEN_HASH_FILE
TRAVEL_PORT=REPLACE_WITH_LOOPBACK_PORT
